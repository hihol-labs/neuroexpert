# ===== ОБЩИЕ =====
NODE_ENV=                                # production | development
APP_URL=                                 # Основной URL приложения (https://neuroexpertise.ru)

# ===== SUPABASE =====
NEXT_PUBLIC_SUPABASE_URL=                # URL Supabase (https://supabase.neuroexpertise.ru)
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # Публичный anon-ключ
SUPABASE_SERVICE_ROLE_KEY=               # Серверный ключ (только backend)
SUPABASE_DB_URL=                         # Прямое подключение к БД (postgresql://postgres:PASSWORD@db:5432/postgres)
SUPABASE_DB_PASSWORD=                    # Пароль PostgreSQL
SUPABASE_JWT_SECRET=                     # JWT-секрет Supabase

# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=                      # Токен бота (@neuroexpert_bot)
TELEGRAM_WEBHOOK_SECRET=                 # Секрет для верификации вебхука
TELEGRAM_WEBHOOK_URL=                    # URL вебхука (https://neuroexpertise.ru/api/webhooks/telegram)

# ===== OPENAI =====
OPENAI_API_KEY=                          # Whisper + GPT-4o-mini (bulk)
OPENAI_MODEL_BULK=                       # Модель для массового анализа (gpt-4o-mini)
OPENAI_PROXY_URL=                        # HTTP-прокси для OpenAI (для РФ): http://user:pass@proxy:port

# ===== CLAUDE (PRIMARY LLM) =====
ANTHROPIC_API_KEY=                       # Claude API
ANTHROPIC_MODEL=                         # Модель для генерации контента (claude-sonnet-4-20250514)
ANTHROPIC_PROXY_URL=                     # HTTP-прокси для Anthropic/Claude (для РФ). Если не задан — fallback на OPENAI_PROXY_URL

# ===== YANDEX (FALLBACK) =====
YANDEX_CLOUD_API_KEY=                    # YandexGPT + YandexSpeechKit
YANDEX_CLOUD_FOLDER_ID=                  # ID каталога в Яндекс.Облаке

# ===== GIGACHAT (FALLBACK) =====
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# ===== LLM PROVIDER SELECTION =====
LLM_PRIMARY_PROVIDER=                    # claude | openai | yandexgpt | gigachat
LLM_FALLBACK_PROVIDER=                   # Провайдер при ошибке primary
STT_PRIMARY_PROVIDER=                    # whisper | yandex_stt
STT_FALLBACK_PROVIDER=                   # Fallback STT-провайдер

# ===== SCANNER / PERPLEXITY =====
PERPLEXITY_API_KEY=                      # Perplexity API (для Scanner и аудита)
YANDEX_API_KEY=                          # Yandex Cloud API Key (для Scanner)
YANDEX_FOLDER_ID=                        # Yandex Cloud Folder ID (для Scanner)

# ===== ДАННЫЕ О СПРОСЕ =====
XMLRIVER_API_KEY=                        # Wordstat через XMLRiver
XMLRIVER_USER_ID=
SERPAPI_API_KEY=                          # SerpAPI (Google PAA, SERP)

# ===== ОПЛАТА (ЮKassa) =====
YUKASSA_SHOP_ID=                         # ID магазина (число из личного кабинета ЮKassa)
YUKASSA_SECRET_KEY=                      # Секретный ключ API: test_* для тестов, live_* для боевого
YUKASSA_WEBHOOK_SECRET=                  # Общий секрет для URL: https://.../api/webhooks/yukassa?secret=<value>
YUKASSA_WEBHOOK_IP_ALLOWLIST=            # CSV IP/CIDR. Пусто = дефолт ЮKassa (185.71.76.0/27,...). "" = отключить IP-check (НЕ для prod)
YUKASSA_MARKETPLACE=                     # true → включить split-payment (transfers[]) при 50+ экспертов. Пусто/false = обычные платежи

# ===== EMAIL =====
RESEND_API_KEY=                          # Resend для email-рассылок
EMAIL_FROM=                              # Адрес отправителя (noreply@neuroexpertise.ru)

# ===== АНАЛИТИКА =====
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=            # Домен для Plausible (neuroexpertise.ru)
PLAUSIBLE_API_KEY=                       # Self-hosted Plausible API

# ===== CDN =====
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=                    # Для purge cache

# ===== ИНДЕКСАЦИЯ =====
GSC_SERVICE_ACCOUNT_JSON=                # Google Search Console (JSON, base64)
BING_WEBMASTER_API_KEY=                  # Bing Webmaster Tools API Key
YANDEX_WEBMASTER_TOKEN=                  # Яндекс.Вебмастер OAuth-токен
YANDEX_WEBMASTER_HOST_ID=

# ===== REVALIDATION =====
REVALIDATION_SECRET=                     # Секрет для ISR revalidation

# ===== КРОССПОСТ =====
DZEN_API_TOKEN=                          # Яндекс Дзен API (опционально)
HABR_API_TOKEN=                          # Хабр API (опционально)

# ===== PUBLIC APP URL =====
NEXT_PUBLIC_APP_URL=                     # https://neuroexpertise.ru

# ===== WORKER =====
WORKER_POLL_INTERVAL_MS=                 # Интервал опроса очереди, мс (5000)
WORKER_CONCURRENCY=                      # Параллельные задачи (3)
