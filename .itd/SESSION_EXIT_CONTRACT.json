{
  "version": 1,
  "mode": "explicit_close",
  "verificationContract": ".itd/VERIFICATION_CONTRACT.json",
  "completionPolicy": ".itd/COMPLETION_POLICY.json",
  "requireCleanGit": true,
  "requiredStateFiles": [
    ".itd-memory/STATE.json"
  ],
  "startupProbeCommand": "pnpm --filter web build",
  "cleanupManifest": ".itd-memory/session-artifacts.json",
  "qualityLedger": ".itd/QUALITY.json",
  "qualityMaxAgeDays": 30,
  "debugScan": {
    "enabled": true,
    "paths": [
      "apps/web/app/(marketing)/page.tsx",
      "apps/web/app/globals.css",
      "apps/web/components/marketing",
      "apps/web/public",
      "scripts"
    ],
    "excludeGlobs": [],
    "patterns": [
      "\\bconsole\\.log\\s*\\(",
      "\\bdebugger\\b",
      "\\bTODO\\b"
    ]
  },
  "periodic": {
    "weeklyMaxAgeDays": 7,
    "weeklyCommands": [],
    "monthlyAblationMaxAgeDays": 31
  }
}
